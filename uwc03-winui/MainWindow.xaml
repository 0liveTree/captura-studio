                </Border>
            </StackPanel>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#CC000000">
            <Border x:Name="SettingsPanel" Width="1080" MaxHeight="1000" CornerRadius="14"
