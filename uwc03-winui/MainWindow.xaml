                                                        <ComboBoxItem Content="96 kbps"/><ComboBoxItem Content="128 kbps"/>
                                                        <ComboBoxItem Content="160 kbps"/><ComboBoxItem Content="192 kbps"/>
                                                        <ComboBoxItem Content="256 kbps"/><ComboBoxItem Content="320 kbps"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="Taxa de amostragem" FontSize="12"/>
                                                    <ComboBox x:Name="AudioRateBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="44 100 Hz"/><ComboBoxItem Content="48 000 Hz"/>
                                                        <ComboBoxItem Content="96 000 Hz"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Canais" FontSize="12"/>
                                                    <ComboBox x:Name="AudioChannelsBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Estéreo"/><ComboBoxItem Content="Mono"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="PCM (bits)" FontSize="12"/>
                                                    <ComboBox x:Name="AudioBitsBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="24-bit"/><ComboBoxItem Content="16-bit"/><ComboBoxItem Content="32-bit"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Modo portátil" FontSize="14" FontWeight="SemiBold"/>
