                                                        <ComboBoxItem Content="22"/><ComboBoxItem Content="23"/>
                                                        <ComboBoxItem Content="25"/><ComboBoxItem Content="28"/>
                                                        <ComboBoxItem Content="32"/>
                                                    </ComboBox>
                                                    <TextBlock Text="0 = máxima, 51 = mínima · 18–32 é a faixa prática."
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE720;" FontSize="14"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="Áudio" FontSize="14" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
