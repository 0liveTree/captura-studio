<Window
    x:Class="CapturaStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Captura Studio">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="CardHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="NotifyBar" Grid.Row="0" Margin="24,12,24,0" Visibility="Collapsed"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="NotifyIcon" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NotifyTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NotifyMessage" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="NotifyClose" Grid.Column="2" Padding="6" Background="Transparent"
                        BorderThickness="0" Click="NotifyClose_Click" ToolTipService.ToolTip="Fechar">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>
        <ScrollViewer x:Name="RootScroll" Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Margin="24" Spacing="16">

                <Grid x:Name="HeaderRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Captura Studio" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Spacing="8" Margin="0,0,10,0">
                        <TextBlock Text="PERFIL" Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProfilePresetBox" Width="190"
                                  SelectionChanged="ProfilePresetBox_SelectionChanged"/>
                        <Button x:Name="ProfilePresetSaveBtn" Content="Guardar…"
                                Click="ProfilePresetSave_Click"/>
                        <Button x:Name="ProfilePresetDeleteBtn" Content="Eliminar"
                                Click="ProfilePresetDelete_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnSettings" Grid.Column="2" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Padding="10,6" ToolTipService.ToolTip="Definições"
                            Click="BtnSettings_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </Button>
                </Grid>

                <Border x:Name="DevicesCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="FONTE" Style="{StaticResource CardHeadingStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="DISPOSITIVO DE VÍDEO" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="VideoBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="RESOLUÇÃO" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ResBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="FPS" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="FpsBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="FORMATO" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Auto" IsSelected="True"/>
                                <ComboBoxItem Content="NV12"/>
                                <ComboBoxItem Content="MJPEG"/>
                                <ComboBoxItem Content="YUY2"/>
                                <ComboBoxItem Content="RGB32"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="DISPOSITIVO DE ÁUDIO" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="AudioBox" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                    </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="MainGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColLeft" Width="1.2*"/>
                        <ColumnDefinition x:Name="ColRight" Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftPane" Grid.Column="0" Spacing="16" Margin="0,0,16,0">

                        <Border x:Name="VideoCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="VÍDEO" Style="{StaticResource CardHeadingStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CODEC" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CodecBox" HorizontalAlignment="Stretch" SelectionChanged="CodecBox_SelectionChanged"
                                                  ToolTipService.ToolTip="H.264 é compatível com tudo; H.265 dá melhor qualidade por bitrate.">
                                            <ComboBoxItem Content="H.264" IsSelected="True"/>
                                            <ComboBoxItem Content="H.265 (HEVC)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="PERFIL H.264" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Baseline"/>
                                            <ComboBoxItem Content="Main"/>
                                            <ComboBoxItem Content="High" IsSelected="True"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="BITRATE (Mbps)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="BitrateBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Quanto maior, melhor a imagem — e maior o ficheiro.">
                                            <ComboBoxItem Content="4 Mbps"/>
                                            <ComboBoxItem Content="8 Mbps"/>
                                            <ComboBoxItem Content="12 Mbps" IsSelected="True"/>
                                            <ComboBoxItem Content="20 Mbps"/>
                                            <ComboBoxItem Content="30 Mbps"/>
                                            <ComboBoxItem Content="50 Mbps"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="ENCODER" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="HwBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="GPU usa NVENC/QSV/AMF quando disponível; CPU é mais lento mas sempre funciona.">
                                            <ComboBoxItem Content="GPU" IsSelected="True"/>
                                            <ComboBoxItem Content="CPU (software)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="RATE CONTROL" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="RateBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Taxa de bits constante" IsSelected="True"/>
                                            <ComboBoxItem Content="Valor de quantização constante"/>
                                            <ComboBoxItem Content="Taxa de bits variável"/>
                                            <ComboBoxItem Content="Taxa de bits variável com qualidade do alvo"/>
                                            <ComboBoxItem Content="Sem perdas"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="KEYFRAME (GOP)" Style="{StaticResource FieldLabelStyle}"/>
                                        <NumberBox x:Name="GopBox" HorizontalAlignment="Stretch"
                                                   Minimum="0" Maximum="30" SmallChange="1" LargeChange="5"
                                                   Value="2" SpinButtonPlacementMode="Compact"
                                                   ToolTipService.ToolTip="Intervalo entre keyframes em segundos; 0 = automático."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="ESPAÇO DE COR" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="ColorSpaceBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Rec.709 para HD/SDR; Rec.2020 para HDR/4K.">
                                            <ComboBoxItem Content="Rec.709" IsSelected="True"/>
                                            <ComboBoxItem Content="Rec.2020"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="INTERVALO" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="ColorRangeBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Limitado (16-235)" IsSelected="True"/>
                                            <ComboBoxItem Content="Completo (0-255)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="PRESET" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="NVENC p1–p7 / CPU ultrafast–slow. p5·fast é o equilíbrio.">
                                            <ComboBoxItem Content="p1 · ultrafast"/>
                                            <ComboBoxItem Content="p2 · superfast"/>
                                            <ComboBoxItem Content="p3 · veryfast"/>
                                            <ComboBoxItem Content="p4 · faster"/>
                                            <ComboBoxItem Content="p5 · fast" IsSelected="True"/>
                                            <ComboBoxItem Content="p6 · medium"/>
                                            <ComboBoxItem Content="p7 · slow"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="AFINAÇÃO" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="TuneBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Afinação do encoder; baixa latência reduz o atraso à custa de qualidade.">
                                            <ComboBoxItem Content="Qualidade" IsSelected="True"/>
                                            <ComboBoxItem Content="Baixa latência"/>
                                            <ComboBoxItem Content="Ultra baixa latência"/>
                                            <ComboBoxItem Content="Sem afinação"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="B-FRAMES" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="BframesBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="0"/>
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3" IsSelected="True"/>
                                            <ComboBoxItem Content="4"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="MULTIPASS" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="MultipassBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Só NVENC; duas passagens dão melhor qualidade ao mesmo bitrate.">
                                            <ComboBoxItem Content="Desligado" IsSelected="True"/>
                                            <ComboBoxItem Content="Uma passagem"/>
                                            <ComboBoxItem Content="Completa"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CQ (QUALIDADE)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="CqBox" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Valor de quantização: menor = melhor qualidade.">
                                            <ComboBoxItem Content="18"/>
                                            <ComboBoxItem Content="20"/>
                                            <ComboBoxItem Content="22"/>
                                            <ComboBoxItem Content="23" IsSelected="True"/>
                                            <ComboBoxItem Content="25"/>
                                            <ComboBoxItem Content="28"/>
                                            <ComboBoxItem Content="32"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock x:Name="QualityHint" Grid.Row="6" Grid.Column="1"
                                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="CQ aplica-se aos modos de quantização constante e qualidade alvo."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AudioCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE720;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="ÁUDIO" Style="{StaticResource CardHeadingStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CODIFICADOR DE ÁUDIO" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="AudioModeBox" HorizontalAlignment="Stretch" SelectionChanged="AudioModeBox_SelectionChanged">
                                            <ComboBoxItem Content="Sem áudio"/>
                                            <ComboBoxItem Content="AAC" IsSelected="True"/>
                                            <ComboBoxItem Content="PCM"/>
                                            <ComboBoxItem Content="MP3 (FFmpeg)"/>
                                            <ComboBoxItem Content="FLAC (FFmpeg)"/>
                                            <ComboBoxItem Content="Opus (FFmpeg)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="BITRATE ÁUDIO (kbps)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="AbrBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="96"/>
                                            <ComboBoxItem Content="128"/>
                                            <ComboBoxItem Content="160"/>
                                            <ComboBoxItem Content="192" IsSelected="True"/>
                                            <ComboBoxItem Content="256"/>
                                            <ComboBoxItem Content="320"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="TAXA DE AMOSTRAGEM" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="AudioRateBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="44100 Hz"/>
                                            <ComboBoxItem Content="48000 Hz" IsSelected="True"/>
                                            <ComboBoxItem Content="96000 Hz"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="CANAIS" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="AudioChannelsBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Estéreo" IsSelected="True"/>
                                            <ComboBoxItem Content="Mono"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="PCM (BITS)" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="AudioBitsBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="24-bit" IsSelected="True"/>
                                            <ComboBoxItem Content="16-bit"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="NÍVEL" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="AudioMeterText" Text="-60 dB"
                                                       HorizontalAlignment="Right" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <ProgressBar x:Name="AudioMeter" Minimum="0" Maximum="1"
                                                     Value="0" Height="6"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RecCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="GRAVAÇÃO" Style="{StaticResource CardHeadingStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PASTA DE DESTINO" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="FolderBox" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CONTENTOR" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="ContBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="MP4" IsSelected="True"/>
                                            <ComboBoxItem Content="MKV"/>
                                            <ComboBoxItem Content="TS"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="PARAR APÓS" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="DurBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Manual" IsSelected="True"/>
                                            <ComboBoxItem Content="5 s"/>
                                            <ComboBoxItem Content="10 s"/>
                                            <ComboBoxItem Content="30 s"/>
                                            <ComboBoxItem Content="60 s"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="DIVISÃO AUTO" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="SplitBox" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Sem divisão" IsSelected="True"/>
                                            <ComboBoxItem Content="5 min"/>
                                            <ComboBoxItem Content="10 min"/>
                                            <ComboBoxItem Content="30 min"/>
                                            <ComboBoxItem Content="60 min"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ActionsRow" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnRec" Content="GRAVAR" Width="150" Height="40" Click="BtnRec_Click"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                            <Button x:Name="BtnStop" Content="PARAR" Width="110" Height="40"
                                    IsEnabled="False" Click="BtnStop_Click"/>
                            <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="14,6" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Pronto"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16">

                        <Border x:Name="PreviewCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16"
                                VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PreviewTitle" Text="PRÉ-VISUALIZAÇÃO"
                                           Style="{StaticResource CardHeadingStyle}"/>
                                <Border x:Name="PreviewBorder" Background="#111111" CornerRadius="6" Height="620"
                                        DoubleTapped="PreviewBorder_DoubleTapped">
                                    <Grid>
                                        <Image x:Name="PreviewImage" Stretch="Uniform"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <TextBlock x:Name="PreviewHint" Text="Sem preview"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="InfoDevice" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="·" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="InfoMode" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="·" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="InfoAudio" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Grid x:Name="PreviewControls" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <StackPanel x:Name="FsRecRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                            <Button Content="Gravar" Click="BtnRec_Click" Style="{ThemeResource AccentButtonStyle}"/>
                                            <Button Content="Parar" Click="BtnStop_Click"/>
                                        </StackPanel>
                                        <Button x:Name="BtnPreview" Click="BtnPreview_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                                <TextBlock x:Name="PreviewBtnText" Text="Pré-visualizar"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnFull" Width="40" Height="34" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTipService.ToolTip="Ecrã inteiro" Click="BtnFull_Click">
                                            <FontIcon x:Name="FullIcon" Glyph="&#xE740;" FontSize="15"/>
                                        </Button>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="8" Padding="12,4">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Button x:Name="BtnMute" Padding="6" Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="Silenciar" Click="BtnMute_Click">
                                                <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="14"/>
                                            </Button>
                                            <ToggleSwitch x:Name="PreviewAudioSwitch" OnContent="" OffContent=""
                                                          IsOn="True" VerticalAlignment="Center" MinWidth="0"/>
                                            <Slider x:Name="VolSlider" Width="130" Minimum="0" Maximum="100" Value="80"
                                                    StepFrequency="5" VerticalAlignment="Center"
                                                    ValueChanged="VolSlider_ValueChanged"/>
                                            <TextBlock x:Name="VolText" Text="80 %" FontSize="12" MinWidth="42"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LogCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <Expander x:Name="LogExpander" Header="Registo" IsExpanded="False" HorizontalAlignment="Stretch">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12" BorderThickness="0" Background="Transparent" Height="140"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                        </Border>

                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FsOverlay" Visibility="Collapsed" Background="Black">
            <Image x:Name="FsImage" Stretch="UniformToFill"/>
            <StackPanel x:Name="FsBar" Orientation="Horizontal" Spacing="12"
