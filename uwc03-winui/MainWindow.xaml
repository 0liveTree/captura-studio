                                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="PortableSwitch" Header="Ativar modo portátil"
                                                          Toggled="PortableSwitch_Toggled"/>
