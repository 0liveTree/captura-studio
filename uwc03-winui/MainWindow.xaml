                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Padding="24,24,14,24">
                            <TextBlock Text="Definições" FontSize="24" FontWeight="SemiBold" Margin="6,0,0,18"/>
                            <TextBlock Text="CONFIGURAÇÃO" Style="{StaticResource NavGroupStyle}" Margin="10,0,0,6"/>
                            <ListView x:Name="SettingsNav" SelectionMode="Single"
                                      SelectionChanged="SettingsNav_SelectionChanged">
                                <ListViewItem Tag="rec">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14"/>
                                        <TextBlock Text="Gravação"/>
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="appearance">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE790;" FontSize="14"/>
                                        <TextBlock Text="Aparência"/>
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                            <TextBlock Text="APLICAÇÃO" Style="{StaticResource NavGroupStyle}" Margin="10,18,0,6"/>
