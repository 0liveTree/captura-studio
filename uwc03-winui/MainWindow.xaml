                                                        <ComboBoxItem Content="Qualidade"/>
                                                        <ComboBoxItem Content="Baixa latência"/>
                                                        <ComboBoxItem Content="Ultra baixa latência"/>
                                                        <ComboBoxItem Content="Sem afinação"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="B-frames" FontSize="12"/>
                                                    <ComboBox x:Name="BframesBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/>
                                                        <ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                                                        <ComboBoxItem Content="4"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Multipass" FontSize="12"/>
