                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="FolderBox2"/>
                                                <Button Grid.Column="1" Content="Procurar…" Click="SettingsBrowse_Click"/>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Nome do ficheiro" FontSize="12"/>
