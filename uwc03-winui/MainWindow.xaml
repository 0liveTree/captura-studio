                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="Cor de destaque" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Aplicada aos botões principais e realces."
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <ComboBox x:Name="AccentBox" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Cor do Windows"/><ComboBoxItem Content="Azul"/>
                                                        <ComboBoxItem Content="Verde"/><ComboBoxItem Content="Laranja"/>
                                                        <ComboBoxItem Content="Roxo"/><ComboBoxItem Content="Vermelho"/>
                                                        <ComboBoxItem Content="Amarelo"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                                    <TextBlock Text="Fundo" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Efeito visual por trás da janela."
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Mica"/><ComboBoxItem Content="Mica Alt"/>
                                                        <ComboBoxItem Content="Acrílico"/><ComboBoxItem Content="Nenhum"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="Idioma" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Língua dos textos da interface."
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <ComboBox x:Name="LanguageBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Português"/>
                                                        <ComboBoxItem Content="Inglês"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Pré-visualização e comportamento" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Define o arranque e os controlos de áudio da pré-visualização."
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch x:Name="AutoPrevSwitch" Header="Iniciar ao abrir"
                                                              OnContent="Sim" OffContent="Não"/>
                                                <ToggleSwitch x:Name="ShowInfoSwitch" Grid.Column="1" Header="Mostrar detalhes"
                                                              OnContent="Sim" OffContent="Não"/>
                                            </Grid>
                                            <StackPanel Spacing="5">
                                                <Grid>
                                                    <TextBlock Text="Volume" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="SettingsVolumeValue" Text="80 %" FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </Grid>
                                                <Slider x:Name="VolSlider2" Minimum="0" Maximum="100" StepFrequency="5"
                                                        HorizontalAlignment="Stretch" ValueChanged="SettingsVolume_ValueChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="SecSobre" Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Sobre" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Informação da aplicação, recursos e créditos."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="10"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        VerticalAlignment="Center">
                                                    <Image x:Name="AboutIcon" Width="32" Height="32"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="Captura Studio" FontSize="18" FontWeight="SemiBold"/>
                                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="BETA" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="VersionText" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Abrir pasta de gravações"
                                                        VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"
                                                        Click="OpenFolder_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="AboutText" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="#3326A17D" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="MIT · Código aberto" FontSize="11"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="Feito em Portugal ❤" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Atualizações" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UpdateCurrentText" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="URL do manifesto" FontSize="12"/>
                                                <TextBox x:Name="UpdateUrlBox" PlaceholderText="https://.../latest.json"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="UpdateAutoSwitch" Header="Verificar ao arrancar" IsOn="True"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnCheckUpdates" Content="Verificar atualizações"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Click="BtnCheckUpdates_Click"/>
                                                <TextBlock x:Name="UpdateStatusText" Grid.Column="1" FontSize="11"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Acesso rápido" FontSize="13" FontWeight="SemiBold"/>
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" HorizontalContentAlignment="Left"
                                                    Click="OpenSettingsFolder_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                                    <TextBlock Text="Pasta de definições"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Left"
                                                    Click="OpenEncoders_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <FontIcon Glyph="&#xE9D5;" FontSize="14"/>
                                                    <TextBlock Text="Encoders disponíveis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Left"
                                                    Click="OpenLicense_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                                    <TextBlock Text="Licença MIT"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Left"
                                                    Click="OpenFfmpeg_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                                    <TextBlock Text="Obter FFmpeg"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Tecnologias" FontSize="13" FontWeight="SemiBold"/>
                                        <Grid x:Name="TechList" ColumnSpacing="8" RowSpacing="8"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Contribuições" FontSize="13" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="ModelsList" Spacing="8"/>
                                    </StackPanel>

                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="14,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="LicenseText" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="CreditsText" FontSize="12" TextWrapping="Wrap"
                                                       FontFamily="Segoe UI Emoji, Segoe UI"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="SecDiagnostico" Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Diagnóstico" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Placa, motor, FFmpeg e logs. Copia ou exporta para um relatório."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Atualizar" Click="DiagnosticsRefresh_Click"/>
                                        <Button Content="Copiar" Click="DiagnosticsCopy_Click"/>
                                        <Button Content="Exportar…" Click="DiagnosticsExport_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="DiagText" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                                             Height="430"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="32,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Content="Fechar" Width="120" Click="SettingsCancel_Click"/>
                            <Button Content="Guardar" Width="120" Style="{ThemeResource AccentButtonStyle}"
                                    Click="SettingsSave_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Assets/videotape.ico"
                        ToolTipText="Captura Studio">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Mostrar" Click="TrayShow_Click"/>
                    <MenuFlyoutItem Text="Gravar" Click="TrayRecord_Click"/>
                    <MenuFlyoutItem Text="Parar" Click="TrayStop_Click"/>
                    <MenuFlyoutItem Text="Pausar/Retomar" Click="TrayPause_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Sair" Click="TrayExit_Click"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
