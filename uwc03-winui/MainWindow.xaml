                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Taxa de bits" FontSize="12"/>
                                                    <ComboBox x:Name="BitrateBox2" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="4 Mbps"/><ComboBoxItem Content="8 Mbps"/>
                                                        <ComboBoxItem Content="12 Mbps"/><ComboBoxItem Content="20 Mbps"/>
                                                        <ComboBoxItem Content="30 Mbps"/><ComboBoxItem Content="50 Mbps"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Processador" FontSize="12"/>
