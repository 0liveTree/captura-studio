                <Button Content="Parar" Click="BtnStop_Click"/>
                <Button Content="Parar pré-visualização" Click="BtnPreview_Click"/>
                <Button Width="40" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="Sair do ecrã inteiro" Click="BtnFull_Click">
                    <FontIcon Glyph="&#xE73F;" FontSize="15"/>
                </Button>
                <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="10,2" VerticalAlignment="Center">
