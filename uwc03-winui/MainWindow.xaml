                                                        <ComboBoxItem Content="10 min"/><ComboBoxItem Content="30 min"/>
                                                        <ComboBoxItem Content="60 min"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Margin="0,4,0,0"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
